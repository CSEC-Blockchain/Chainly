# ─── LLM provider (server-side only) ──────────────────────────────────────────
# Default: Vercel AI Gateway with a free model (nvidia/nemotron-3.5-lightning-free).
# Create a key at https://vercel.com/dashboard → AI Gateway → API Keys.
# On Vercel deployments the OIDC token is used automatically, so no key is needed.
AI_GATEWAY_API_KEY=

# Optional: use another provider instead. If LLM_PROVIDER is omitted, Chainly
# auto-detects it from whichever key is set (AI Gateway first).
#   gateway | openai | anthropic | google | openai-compatible
LLM_PROVIDER=
# Optional model override. Defaults: nvidia/nemotron-3.5-lightning-free (gateway),
# gpt-5-mini, claude-sonnet-5-5, gemini-2.5-flash. On the gateway, use any
# "creator/model" ID, e.g. reflection/beam-free or anthropic/claude-sonnet-5-5.
LLM_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Any OpenAI-compatible API: Groq, OpenRouter, Together, Ollama, LM Studio...
#   Groq:   https://api.groq.com/openai/v1
#   Ollama: http://localhost:11434/v1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ─── Blockchain ───────────────────────────────────────────────────────────────
# Network: Ethereum Sepolia (chain ID 11155111).
# Optional private RPC for the server (e.g. Alchemy/Infura). Falls back to
# publicnode, drpc and 1rpc public endpoints if unset or failing.
SEPOLIA_RPC_URL=
# Optional RPC used by the browser for the live block / wallet balance (this one IS public).
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Optional. With a key, wallet history comes from Etherscan V2 (chainid 11155111).
# Without one, Chainly uses Blockscout's free keyless API.
ETHERSCAN_API_KEY=
